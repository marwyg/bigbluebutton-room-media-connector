{
  "compilerOptions": {
    "module": "esnext",
    "target": "esnext",
    "sourceMap": false,
    "moduleResolution": "Node",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "isolatedModules": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "/@/*": ["./src/*"]
    }
  },
  "include": ["src/**/*.ts", "../../types/**/*.d.ts", "src/meeting_room_provider/pilosMeetingRoomProvider.ts", "src/meeting_room_provider/meetingProviderFactory.ts", "src/meeting_room_provider/IMeetingRoomProvider.ts"],
  "exclude": ["**/*.spec.ts", "**/*.test.ts"]
}
